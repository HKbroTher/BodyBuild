<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the engine-free gameplay core from Assets/Scripts/Core outside of Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepoRoot)Assets/Scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
